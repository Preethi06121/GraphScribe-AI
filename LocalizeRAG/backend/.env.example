# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# RAG / Ingestion
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=localizerag_documents
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TEMP_UPLOAD_DIR=./data/uploads

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# NLP
SPACY_MODEL=en_core_web_sm

# Hybrid Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_GRAPH_WEIGHT=0.3
RETRIEVAL_CACHE_SIZE=128

# LLM / Content Generation
LLM_PROVIDER=ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Future configuration placeholders
# OPENAI_API_KEY=
# DATABASE_URL=
